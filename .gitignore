# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
venv/

# 실행하면 생기는 산출물 (각자 PC에서 다시 만들어지므로 공유하지 않음)
## 대시보드·/data/upload 로 올린 CSV (폴더 유지용 .gitkeep만 커밋)
data/uploads/*
!data/uploads/.gitkeep
## 학습된 모델·스케일러 (train_baseline_v1.py, train_and_register.py가 생성)
serving_app/models/*
!serving_app/models/.gitkeep
## MLflow 로컬 기록 (sqlite + 아티팩트)
mlflow.db
mlruns/
mlartifacts/
## AIOps 로그 (서버 기동 시 logs/ 폴더가 자동 생성됨)
logs/

# data/synthetic/ 은 커밋한다 : 팀원 모두가 같은 합성 데이터로 모델을 비교하기 위함
# (scripts/generate_sales_data.py, seed 42로 다시 만들 수도 있음)

# 환경 변수·비밀 정보
.env
.env.*

# OS·에디터
.DS_Store
.idea/
.vscode/
*.swp
